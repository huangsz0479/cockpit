{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Cockpit desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/huangsz0479/cockpit/releases*" }
      ]
    },
    "core:window:allow-start-dragging"
  ]
}
